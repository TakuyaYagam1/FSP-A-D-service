FROM gcc:13.5.0-bookworm@sha256:20eec427045c47d0aad1bd28c81d435916c327cd992240aa78350f755d04d04a AS build

ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG NO_PROXY

# Ghostscript 10.06.0 включает исправления, выпущенные после 10.03.1
# Это более широкий security-апдейт, но для сборки нужна правка зависимости sarc4.dev ниже
# Архив закреплен SHA-512 из релиза Artifex
# https://github.com/ArtifexSoftware/ghostpdl-downloads/releases/tag/gs10060
RUN curl --fail --location --retry 2 \
        --output /tmp/ghostscript-10.06.0.tar.xz \
        https://github.com/ArtifexSoftware/ghostpdl-downloads/releases/download/gs10060/ghostscript-10.06.0.tar.xz \
    && echo 'e9efa6a334cf34703f565f5043dd794452270415b34c2bea260e9dac6c72ebbcbedfa2e4cb9029841f8f582bbce91be8160e135a190081f3262bcf04417f80f1  /tmp/ghostscript-10.06.0.tar.xz' \
        | sha512sum -c - \
    && tar -xf /tmp/ghostscript-10.06.0.tar.xz -C /tmp

WORKDIR /tmp/ghostscript-10.06.0

# В 10.06.0 pdfi использует ArcFour, но не подключает sarc4.dev при линковке
RUN sed -i 's/$(PDFGEN)pdiff.dev/$(GLD)sarc4.dev $(PDFGEN)pdiff.dev/g' pdf/pdf.mak

RUN CFLAGS='-O2 -std=gnu17 -fPIE' LDFLAGS='-pie' \
    ./configure \
        --prefix=/opt/ghostscript \
        --disable-cups \
        --disable-gtk \
        --without-tesseract \
        --with-drivers=PNG,uniprint \
    && make -j2 \
    && make install

RUN set -eu; \
    mkdir -p /opt/ghostscript/lib; \
    ldd /opt/ghostscript/bin/gs > /tmp/gs-libraries; \
    if grep -q 'not found' /tmp/gs-libraries; then \
        cat /tmp/gs-libraries; \
        exit 1; \
    fi; \
    awk '{ for (i = 1; i <= NF; i++) if ($i ~ /^\//) print $i }' /tmp/gs-libraries \
        | sort -u \
        | while IFS= read -r path; do \
            name=${path##*/}; \
            case "$name" in \
                libc.so.*|libm.so.*|libpthread.so.*|libdl.so.*) ;; \
                librt.so.*|libresolv.so.*|libutil.so.*|libanl.so.*|ld-linux*.so.*) ;; \
                *) cp -L "$path" "/opt/ghostscript/lib/$name" ;; \
            esac; \
        done

FROM debian:12.15-slim@sha256:99c0b25c46d0214d5a2091092e7908907dcaecd6a962cde0ac700acee222b6f3

RUN mkdir -p /var/lib/wahrwelt/archive /var/lib/wahrwelt/preview \
    && chown -R 10001:10001 /var/lib/wahrwelt
COPY --from=build /opt/ghostscript /opt/ghostscript
COPY worker.sh /usr/local/bin/renderer
RUN chmod 0755 /usr/local/bin/renderer
ENV PATH=/opt/ghostscript/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    LD_LIBRARY_PATH=/opt/ghostscript/lib
WORKDIR /var/lib/wahrwelt
USER 10001:10001
HEALTHCHECK --interval=2s --timeout=1s --start-period=3s --retries=20 \
    CMD test -f /var/lib/wahrwelt/preview/.ready
ENTRYPOINT ["/usr/local/bin/renderer"]
